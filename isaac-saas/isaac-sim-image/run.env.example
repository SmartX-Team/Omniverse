# 이 파일을 복사해서 run.env 로 쓰고, 값만 채우면 됩니다.
#   cp run.env.example run.env
# (run.env 는 비밀번호 포함 → git 커밋 금지)

# --- Nucleus 접속 ---
OMNI_SERVER=omniverse://YOUR_NUCLEUS_HOST/
OMNI_USER=CHANGE_ME
OMNI_PASS=CHANGE_ME

# --- 확장(Extension) ---
EXT_LOCAL_PATH=          # 호스트의 확장 repo 경로 (빌드에 포함했으면 비워둠)
EXT_PREFIX=[ext]         # 이 접두사 폴더만 등록 (비우면 전부)

# --- 실행 모드 (둘 다 false = headless) ---
START_GUI=false
START_WEBRTC=true

# --- WebRTC 스트리밍 (6.0 신규 env, 선택) ---
ISAACSIM_HOST=           # 외부에서 접속할 호스트 IP (기본 127.0.0.1 — 원격 접속 시 필수)
ISAACSIM_SIGNAL_PORT=    # 기본 49100 (TCP)
ISAACSIM_STREAM_PORT=    # 기본 47998 (UDP)

# --- 시작 시 열 Scene USD (선택) ---
STARTUP_USD_STAGE=       # 예: omniverse://YOUR_NUCLEUS_HOST/Projects/OOS/scene.usd

# 그 외(GPU_DEVICE, GPU_MODE, IMAGE_TAG, CACHE_ROOT 등)는 run.sh 기본값 사용.
