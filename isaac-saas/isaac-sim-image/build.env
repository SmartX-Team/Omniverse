# 빌드 설정. 값만 바꾸세요.

# 확장 repo (public) — 빌드 시 이미지에 clone 포함
EXT_REPO_URLS="https://github.com/SmartX-Team/Omniverse.git"

EXT_SRC_DIR="/opt/oos_omniverse_extensions"
# 중립 명명 정책(회사명 제거): 이미지명 isaac-sim (구 oos-isaac-sim)
IMAGE_NAME="isaac-sim"
IMAGE_TAG="6.0"

# 외부 ROS 워크스페이스(jazzy_ws) 빌드 여부. 0=생략(내장 브리지 사용, 권장) / 1=빌드
BUILD_ROS_WS="0"

# Harbor 푸쉬 (선택): build.sh 에서 PUSH=1 일 때 사용
HARBOR="10.38.38.210"
PROJECT="dt-saas"
